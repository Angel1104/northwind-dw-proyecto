        "lineageTag": "da66bef1-a208-4cb6-bd3c-b91de49af3cb",
        "measures": [
          {
            "name": "Ventas netas",
            "displayFolder": "Medidas",
            "expression": "SUM(FactSales[TotalVenta])",
            "formatString": "#,0.00",
            "lineageTag": "f7150990-a466-4bfe-930d-aabef793192d"
          },
          {
            "name": "Unidades",
            "displayFolder": "Medidas",
            "expression": "SUM(FactSales[Quantity])",
            "formatString": "#,0",
            "lineageTag": "135017a5-e723-4529-ace4-78a50a7e2ba7"
          },
          {
            "name": "Pedidos",
            "displayFolder": "Medidas",
            "expression": "DISTINCTCOUNT(FactSales[OrderID])",
            "formatString": "#,0",
            "lineageTag": "7fffaa41-6f85-4f1e-97e4-ee9ee9fa0078"
          },
          {
            "name": "Ticket promedio",
            "displayFolder": "Medidas",
            "expression": "DIVIDE([Ventas netas], [Pedidos])",
            "formatString": "#,0.00",
            "lineageTag": "8d83330c-92e5-4cff-9e63-2ae924deb4a2"
          },
          {
            "name": "Ventas brutas",
            "displayFolder": "Medidas",
            "expression": "SUMX(FactSales, FactSales[Quantity] * FactSales[UnitPrice])",
            "formatString": "#,0.00",
            "lineageTag": "327b7547-99cc-4d3b-90c6-4a1068054bd4"
          },
          {
            "name": "Descuento monetario",
            "displayFolder": "Medidas",
            "expression": "[Ventas brutas] - [Ventas netas]",
            "formatString": "#,0.00",
            "lineageTag": "f315d19b-47a0-4b0a-8b8a-25350b9c0be1"
          },
          {
            "name": "Descuento efectivo %",
            "displayFolder": "Medidas",
            "expression": "DIVIDE([Descuento monetario], [Ventas brutas])",
            "formatString": "0.00%",
            "lineageTag": "b2e24568-696e-446a-9a5a-2c25b29c19d5"
          }
        ],
        "partitions": [
          {
            "name": "FactSales",
